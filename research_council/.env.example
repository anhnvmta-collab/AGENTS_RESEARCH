# Credential names only. Never commit a populated .env or place keys in YAML/logs/outputs.
# Only providers with enabled routes need their model key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENALEX_API_KEY=
# Pass --config explicitly; this variable does not select validate-science/preflight configuration.
RESEARCH_COUNCIL_CONFIG=config/default.yaml
